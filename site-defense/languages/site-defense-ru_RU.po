msgid "Check WPVulnerability daily"
msgstr "Ежедневно проверять WPVulnerability"

msgid "New vulnerability found"
msgstr "Обнаружена новая уязвимость"

msgid "Update review needed"
msgstr "Проверьте наличие исправления"

msgid "Component: %1$s · Installed version: %2$s"
msgstr "Компонент: %1$s · Установленная версия: %2$s"

msgid "Fixed version: %s"
msgstr "Версия с исправлением: %s"

msgid ""
"Email uses the event selection above. New vulnerabilities are sent through "
"email and Telegram. Blocked attempts are grouped into five-minute summaries."
msgstr ""
"По почте отправляются выбранные выше события. Новые уязвимости можно "
"получать по почте и в Telegram. Заблокированные попытки объединяются в "
"сводки за пять минут."

msgid "Installed components with advisory records — %1$s of %2$s"
msgstr "Установленные компоненты, по которым есть записи — %1$s из %2$s"

msgid ""
"WPVulnerability requests use plugin and theme identifiers. Version "
"comparison runs locally and keeps the last successful API response."
msgstr ""
"В WPVulnerability передаются идентификаторы плагинов и тем. Версии сверяются"
" на сайте, где хранится последний успешный ответ API."

msgid ""
"WPVulnerability cache: %1$d of %2$d components. Entries older than one day: "
"%3$d."
msgstr ""
"Кеш WPVulnerability: %1$d из %2$d компонентов. Записей старше суток: %3$d."

msgid "Waiting for the first WPVulnerability check."
msgstr "Ожидается первая проверка WPVulnerability."

msgid "Active until %s."
msgstr "Активен до %s."

msgid "Allow plugin and theme installation and file editing again?"
msgstr "Снова разрешить установку плагинов и тем и редактирование файлов?"

msgid "An application password target is invalid or unavailable."
msgstr "Указанный пароль приложения недоступен или идентификатор неверен."

msgid "Application passwords · user ID:UUID pairs separated by commas"
msgstr "Пароли приложений · пары ID пользователя:UUID через запятую"

msgid "Apply this plan and enable incident mode?"
msgstr "Применить план и включить режим инцидента?"

msgid "Browser sessions · User IDs separated by commas"
msgstr "Сессии браузера · ID пользователей через запятую"

msgid "CISA KEV is current."
msgstr "Каталог CISA KEV актуален."

msgid "CISA KEV added %1$s on %2$s."
msgstr "CISA KEV добавил %1$s в каталог %2$s."

msgid "CISA KEV update is already running."
msgstr "Обновление CISA KEV уже выполняется."

msgid "CISA Known Exploited Vulnerabilities"
msgstr "Каталог эксплуатируемых уязвимостей CISA KEV"

msgid "Check CISA KEV daily"
msgstr "Ежедневно обновлять каталог CISA KEV"

msgid "Component installed or updated"
msgstr "Установка или обновление компонента"

msgid "Disable incident mode"
msgstr "Выключить режим инцидента"

msgid "Disable incident mode?"
msgstr "Выключить режим инцидента?"

msgid "Discard plan"
msgstr "Отменить план"

msgid "Duration in minutes"
msgstr "Продолжительность в минутах"

msgid "Duration: %d minutes"
msgstr "Продолжительность в минутах: %d"

msgid "Enable external heartbeat"
msgstr "Включить внешний контроль"

msgid "Enable incident mode"
msgstr "Включить режим инцидента"

msgid "Enable incident mode and apply the selected revocations?"
msgstr ""
"Включить режим инцидента и отозвать выбранные сессии и пароли приложений?"

msgid "External heartbeat"
msgstr "Внешний контроль работы"

msgid "Find privileged accounts and application password IDs"
msgstr "Найти привилегированные аккаунты и ID паролей приложений"

msgid "Heartbeat delivered."
msgstr "Сигнал доставлен."

msgid "Heartbeat delivery failed."
msgstr "Не удалось доставить сигнал."

msgid "Heartbeat is disabled."
msgstr "Внешний контроль выключен."

msgid "Heartbeat settings changed"
msgstr "Изменены настройки внешнего контроля"

msgid "Heartbeat settings saved."
msgstr "Настройки внешнего контроля сохранены."

msgid "Heartbeat signing secret"
msgstr "Секрет для подписи сигнала"

msgid "Incident mode"
msgstr "Режим инцидента"

msgid "Incident mode disabled"
msgstr "Режим инцидента выключен"

msgid "Incident mode enabled"
msgstr "Режим инцидента включён"

msgid "Incident mode enabled. Check these application passwords: %s"
msgstr "Режим инцидента включён. Проверьте эти пароли приложений: %s"

msgid "Incident mode is already active."
msgstr "Режим инцидента уже включён."

msgid "Incident mode is being updated. Try again."
msgstr "Режим инцидента обновляется. Попробуйте ещё раз."

msgid "Incident plan"
msgstr "План реагирования"

msgid "Incident plan cancelled."
msgstr "План реагирования отменён."

msgid "Incident timeline"
msgstr "Хронология инцидента"

msgid ""
"Invalid session target. Use WP-CLI to revoke your own browser sessions."
msgstr ""
"Не удалось выбрать пользователя. Для отзыва своих браузерных сессий "
"используйте WP-CLI."

msgid "Known exploitation · CISA KEV"
msgstr "Известна эксплуатация · CISA KEV"

msgid "Known vulnerability is being exploited"
msgstr "Известную уязвимость эксплуатируют"

msgid "Last successful heartbeat"
msgstr "Последний доставленный сигнал"

msgid "Latest 50 relevant events in the past 24 hours."
msgstr "До 50 последних событий за сутки."

msgid "No timeline events recorded."
msgstr "В хронологии пока нет событий."

msgid "Plugin activated"
msgstr "Плагин активирован"

msgid "Plugin deactivated"
msgstr "Плагин деактивирован"

msgid "Preview incident plan"
msgstr "Просмотреть план"

msgid "Receiver HTTPS address"
msgstr "HTTPS-адрес приёмника"

msgid "Remove stored heartbeat secret"
msgstr "Удалить сохранённый секрет"

msgid "Review the incident plan before applying it."
msgstr "Проверьте план перед применением."

msgid "Revoked sessions and application passwords cannot be restored."
msgstr "Отозванные сессии и пароли приложений нельзя восстановить."

msgid "Save heartbeat settings"
msgstr "Сохранить настройки внешнего контроля"

msgid ""
"Send a signed signal about WordPress task health every five minutes. Run the"
" receiver separately so it can report missed signals."
msgstr ""
"Site Defense отправляет подписанный сигнал о состоянии задач WordPress "
"каждые пять минут. Запустите приёмник отдельно, чтобы он мог сообщать о "
"пропущенных сигналах."

msgid "Send heartbeat now"
msgstr "Отправить сигнал сейчас"

msgid "Set the receiver address and secret before enabling heartbeat."
msgstr "Укажите адрес приёмника и секрет перед включением внешнего контроля."

msgid ""
"Temporarily blocks plugin and theme installation, uploads and file editing "
"through WordPress. Use WP-CLI for emergency maintenance."
msgstr ""
"Временно запрещает установку и загрузку плагинов и тем и изменение файлов "
"через WordPress. Для аварийных работ используйте WP-CLI."

msgid "The heartbeat receiver must use a public HTTPS address."
msgstr "У приёмника должен быть публичный HTTPS-адрес."

msgid "Theme changed"
msgstr "Тема изменена"

msgid "This incident plan expired or changed. Preview it again."
msgstr "План устарел или изменился. Откройте предпросмотр заново."

msgid "Unable to refresh CISA KEV."
msgstr "Не удалось обновить каталог CISA KEV."

msgid "Unable to save heartbeat settings."
msgstr "Не удалось сохранить настройки внешнего контроля."

msgid "Unable to save incident mode."
msgstr "Не удалось сохранить режим инцидента."

msgid "Update CISA KEV now"
msgstr "Обновить CISA KEV сейчас"

msgid ""
"Use a duration from 5 to 1440 minutes and at most 50 targets per action."
msgstr ""
"Укажите срок от 5 до 1440 минут и не более 50 целей для каждого действия."

msgid ""
"Use a heartbeat secret of 32 to 128 URL-safe characters and enable PHP "
"Sodium."
msgstr ""
"Укажите секрет из 32–128 букв латиницы, цифр, дефисов или подчёркиваний и "
"включите PHP Sodium."

msgid "Use up to 336 hours and 10000 timeline entries."
msgstr "Укажите не более 336 часов и 10 000 записей хронологии."

msgid "User #%1$d · Application password: %2$s"
msgstr "Пользователь №%1$d · Пароль приложения: %2$s"

msgid "User %1$s (#%2$d) · Browser sessions: %3$d"
msgstr "Пользователь %1$s (№%2$d) · Сессий браузера: %3$d"

msgid "Check these application passwords: %s"
msgstr "Проверьте эти пароли приложений: %s"

msgid "Unable to revoke browser sessions for these user IDs: %s"
msgstr "Не удалось отозвать браузерные сессии для пользователей с ID %s."

msgid "Copy made before repair · #%d"
msgstr "Копия до восстановления · №%d"

msgid "Current SHA-256"
msgstr "Текущий SHA-256"

msgid "Discard repair preview"
msgstr "Отменить предпросмотр"

msgid "File repair preview"
msgstr "Предпросмотр восстановления"

msgid "File repair undone"
msgstr "Восстановление файла отменено"

msgid "File replaced with official copy"
msgstr "Файл заменён официальной копией"

msgid "Installed component: %1$s %2$s"
msgstr "Установленный компонент: %1$s %2$s"

msgid ""
"Keep the original in quarantine and replace this file with the verified "
"copy?"
msgstr "Сохранить оригинал в карантине и заменить файл проверенной копией?"

msgid "Official package from WordPress.org"
msgstr "Официальный пакет WordPress.org"

msgid "Preview file repair"
msgstr "Предпросмотр восстановления"

msgid "Quarantine entry: #%d."
msgstr "Запись в карантине №%d."

msgid "Repair preview discarded."
msgstr "Предпросмотр восстановления отменён."

msgid "Replace %s with the verified file and quarantine the original?"
msgstr "Заменить %s проверенной копией и сохранить оригинал в карантине?"

msgid "Replace with verified file"
msgstr "Заменить проверенной копией"

msgid "Replacement SHA-256"
msgstr "SHA-256 новой копии"

msgid ""
"Return the previous file? It may contain the suspicious code found during "
"the scan."
msgstr ""
"Вернуть прежний файл? Он может содержать подозрительный код, найденный при "
"сканировании."

msgid "The file already matches the official copy."
msgstr "Файл уже совпадает с официальной копией."

msgid ""
"The file changed during verification. Inspect the target and its quarantine "
"copy."
msgstr ""
"Файл изменился во время проверки. Проверьте файл и его копию в карантине."

msgid ""
"The file or installed version changed. Scan again before applying a repair."
msgstr ""
"Файл или установленная версия изменились. Перед восстановлением запустите "
"новую проверку."

msgid "The file was replaced and verified. Quarantine entry: #%d."
msgstr "Файл заменён и проверен. Запись в карантине №%d."

msgid "The official archive or its file could not be verified."
msgstr "Не удалось проверить официальный архив или файл из него."

msgid "The official checksum changed or is unavailable. Create a new preview."
msgstr ""
"Официальная контрольная сумма изменилась или недоступна. Создайте новый "
"предпросмотр."

msgid "The official checksum for this file is unavailable."
msgstr "Официальная контрольная сумма этого файла недоступна."

msgid "The official file was verified. Review the repair preview."
msgstr "Официальный файл проверен. Просмотрите план восстановления."

msgid "The original is in place. Retry to update the repair history."
msgstr ""
"Оригинал на месте. Повторите действие, чтобы обновить историю "
"восстановления."

msgid "The original was returned from quarantine."
msgstr "Оригинал возвращён из карантина."

msgid "The repair path or its permissions could not be verified."
msgstr "Не удалось проверить путь или права доступа к файлу."

msgid "The repair preview expired. Create a new preview."
msgstr "Срок предпросмотра истёк. Создайте новый предпросмотр."

msgid "The replacement could not be staged with the original permissions."
msgstr "Не удалось подготовить замену с исходными правами доступа."

msgid ""
"The server could not atomically replace the file. The quarantine copy is "
"intact."
msgstr "Сервер не смог атомарно заменить файл. Копия сохранена в карантине."

msgid "The server could not stage the replacement beside the original."
msgstr "Сервер не смог подготовить замену в папке исходного файла."

msgid "There is no supported official package for this file."
msgstr "Для этого файла нет поддерживаемого официального пакета."

msgid "This checksum finding is unavailable. Scan the file again."
msgstr "Результат сверки контрольной суммы недоступен. Проверьте файл снова."

msgid "This repair backup is no longer available."
msgstr "Копия для отмены восстановления больше недоступна."

msgid "Unable to save the repair preview."
msgstr "Не удалось сохранить предпросмотр восстановления."

msgid ""
"Unable to verify the original quarantine copy. File replacement was "
"cancelled."
msgstr ""
"Не удалось проверить копию оригинала в карантине. Замена файла отменена."

msgid "Undo file repair"
msgstr "Отменить восстановление"

msgid "Verified official MD5"
msgstr "Проверенная официальная MD5"

msgid "Verified official SHA-256"
msgstr "Проверенная официальная SHA-256"

msgid "A cleanup operation is already running."
msgstr "Операция очистки уже выполняется."

msgid ""
"A selected cleanup target is stale or unknown. Refresh the investigation."
msgstr "Выбранная цель устарела или недоступна. Обновите отчёт расследования."

msgid "Apply the selected cleanup step to %s?"
msgstr "Применить выбранный шаг очистки к %s?"

msgid "Cleanup plan or step was not found."
msgstr "План или шаг очистки не найден."

msgid "Cleanup step applied"
msgstr "Шаг очистки применён"

msgid "Cleanup step unavailable or permission denied."
msgstr "Шаг очистки недоступен или нет прав."

msgid "Cleanup step undone"
msgstr "Шаг очистки отменён"

msgid "Prepare a matching official file repair preview first."
msgstr ""
"Сначала подготовьте предпросмотр восстановления этого файла из официального "
"пакета."

msgid ""
"Return the original target %s? Suspicious code or scheduled actions may "
"return."
msgstr ""
"Вернуть исходный объект %s? Это может вернуть подозрительный код или задачи."

msgid ""
"Select a WordPress user with Site Defense investigation access using --user."
msgstr ""
"Укажите через --user пользователя WordPress с доступом к расследованию Site "
"Defense."

msgid "Select between 1 and 10 cleanup targets from the investigation."
msgstr "Выберите от 1 до 10 целей очистки из отчёта расследования."

msgid "Select only one action per file."
msgstr "Выберите только одно действие для каждого файла."

msgid ""
"The scheduled event changed or the schedule could not be saved. Inspect the "
"current schedule."
msgstr ""
"Задача изменилась или не удалось сохранить расписание. Проверьте текущее "
"расписание."

msgid "The scheduled event changed. Refresh the investigation."
msgstr "Задача изменилась. Обновите отчёт расследования."

msgid "The selected web access log is unavailable."
msgstr "Выбранный журнал HTTP-запросов недоступен."

msgid "The target changed. Retry the same step to update the cleanup history."
msgstr "Цель изменена. Повторите шаг, чтобы обновить историю очистки."

msgid "This cleanup step cannot be changed in its current state."
msgstr "Текущее состояние шага очистки не допускает это действие."

msgid "Unable to save the cleanup plan."
msgstr "Не удалось сохранить план очистки."

msgid "Use up to 168 hours and 200 entries per source."
msgstr "Укажите не более 168 часов и 200 записей на источник."

msgid ""
"The database field changed or is unavailable. Refresh the database audit "
"before continuing."
msgstr ""
"Поле базы данных изменилось или недоступно. Перед продолжением повторите "
"аудит базы данных."

msgid "The database cleanup backup could not be verified."
msgstr "Не удалось проверить резервную копию поля базы данных."

msgid "Database cleanup step not found."
msgstr "Шаг очистки базы данных не найден."

msgid ""
"Restore the original database field %s? The selected script or redirect may "
"return."
msgstr ""
"Восстановить исходное поле базы данных %s? Выбранный скрипт или редирект "
"может вернуться."

msgid "Plugin update channel"
msgstr "Канал обновлений плагина"

msgid "Show updates for"
msgstr "Показывать обновления для"

msgid "Stable releases"
msgstr "Стабильные выпуски"

msgid "Stable releases and release candidates"
msgstr "Стабильные выпуски и кандидаты (RC)"

msgid "Save update channel"
msgstr "Сохранить канал обновлений"

msgid "This Site Defense update is unavailable for the selected channel."
msgstr "Это обновление Site Defense недоступно в выбранном канале."

msgid "The signed Site Defense release could not be verified."
msgstr "Не удалось проверить подписанный выпуск Site Defense."

msgid "Unable to download the Site Defense update."
msgstr "Не удалось скачать обновление Site Defense."

msgid ""
"The Site Defense ZIP failed verification. The installed plugin was kept."
msgstr ""
"Архив Site Defense не прошёл проверку. Установленная версия сохранена."

msgid "Revoke sessions and application passwords"
msgstr "Отзыв сессий и паролей приложений"

msgid "All incidents"
msgstr "Все инциденты"

msgid "Review required"
msgstr "Требуется проверка"

msgid "Delivery status"
msgstr "Статус доставки"

msgid "Firewall rule packages"
msgstr "Пакеты правил WAF"

msgid "Login address"
msgstr "Адрес входа"

msgid "Scan details and signatures"
msgstr "Детали сканирования и сигнатуры"

msgid "Vulnerability database and sources"
msgstr "База и источники уязвимостей"
